# Purpose: Excludes local settings, secrets, data, dependencies, build output, and archived extras from publication.
node_modules/
dist/
.turbo/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.tripraft/
wikidata/
.env
.env.*
!.env.example
*.log
logs/
services/api/uploads/
/extra/
*.rar
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
# Local source documents and data-processing workspaces are never published.
/script/
/sql_database/
\tripraft.db
# Runtime data and SQLite coordination files stay on the machine that runs them.
/data/runtime/
*.db-wal
*.db-shm
*.db-journal
# Keep preserved data and previously untracked reference artifacts local.
/data/archive/*
!/data/archive/README.md
/docs/plans/source-documents/TripRaft_Remote_Beta_and_Sapling_Interactive_Smartlog_Setup.docx
/docs/plans/local-archive/
/docs/extra/*
!/docs/extra/README.md
