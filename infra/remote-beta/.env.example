# Purpose: Hosted beta reference only. Enter actual secrets in Render Environment.
# SECRET_KEY and JWT_SECRET_KEY are generated separately by the Render Blueprint.
FLASK_ENV=production
FLASK_DEBUG=false
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:6379
FRONTEND_URL=https://YOUR_SERVICE.onrender.com
CORS_ORIGINS=https://YOUR_SERVICE.onrender.com
ADMIN_EMAILS=your-staff-email@example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
GUNICORN_WORKERS=1
EMAIL_PROVIDER=gmail
EMAIL_ENABLED=true
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_GMAIL_OAUTH_REFRESH_TOKEN
FROM_EMAIL=YOUR_SENDER@gmail.com
# Alternative: EMAIL_PROVIDER=resend, RESEND_API_KEY=..., FROM_EMAIL=verified-domain-sender
