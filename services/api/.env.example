# Purpose: Documents public configuration keys and placeholder values; copy locally and keep real credentials out of Git.
# =============================================================
# TripRaft Backend — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://127.0.0.1:5173

# Comma-separated IPs/CIDRs of reverse proxies permitted to set
# X-Forwarded-For. Leave empty when the app is directly internet-facing.
TRUSTED_PROXY_IPS=

# Required in production: comma-separated addresses allowed to use admin APIs.
ADMIN_EMAILS=

# --- Redis (optional, gracefully falls back to no-cache) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# --- JWT Key Rotation ---
# Pre-stage v2 before rotating. Set JWT_CURRENT_KEY_VERSION=v2 to activate.
# JWT_SECRET_KEY_V1=<same-as-JWT_SECRET_KEY-initially>
# JWT_SECRET_KEY_V2=<new-random-64-char-string>
# JWT_CURRENT_KEY_VERSION=v1

# --- Email / SMTP (for invitations) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- External APIs ---
TICKETMASTER_API_KEY=

# --- DATABASE CONFIGURATION ---
# Team development: CTO-issued personal restricted login for the shared DEV project.
# Leave blank until issued; setup/start/reload never create or migrate a database.
# Obtain the complete URL privately; URL-encode password characters and require TLS.
DATABASE_URL=
TRIPRAFT_DEV_DB_ROLE=
TRIPRAFT_DEV_DB_HOST=
# Session-pooler shape only (not a usable credential):
# postgresql://tripraft_dev_YOURNAME.PROJECT_REF:ENCODED_PASSWORD@CTO_APPROVED_HOST:5432/postgres?sslmode=require
# Runtime DATABASE_URL must never use postgres, service_role, owner credentials or production URLs.

# Release administrators only: separate schema-owner credentials for the same
# approved development project. Employees leave these blank. Never reuse this
# login as DATABASE_URL. CI uses environment-scoped GitHub secrets/variables.
# Plan: python infra/tools/deploy_database.py --environment development --env-file services/api/.env
MIGRATION_DATABASE_URL=
MIGRATION_EXPECTED_HOST=
MIGRATION_EXPECTED_USER=
MIGRATION_EXPECTED_DATABASE=
#
# Canonical travel catalog (created empty from sql_database/tripraft-global-schema-v2.1.sql)
# Defaults resolve from the repository root; optional overrides:
# TRAVEL_DATABASE_DIR=C:/Tripraft/data/catalog
# TRAVEL_DATABASE_PATH=C:/Tripraft/data/catalog/tripraft-canonical.db
# TRAVEL_DATA_URL=sqlite:///C:/Tripraft/data/catalog/tripraft-canonical.db
# TRAVEL_DATA_URL=postgresql://tripraft:password@read-replica:5432/travel_data
#
# Connection Pool (PostgreSQL only)
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
TRAVEL_POOL_SIZE=1
TRAVEL_MAX_OVERFLOW=0
# SQL_ECHO=false

# =============================================================
# GROUP PLANNER CONFIGURATION
# =============================================================

# --- Feature Flags ---
GP_FEATURE_ENABLED=true
GP_ENABLE_REAL_TIME_UPDATES=true
GP_ENABLE_EMAIL=true
GP_ENABLE_ACTIVITY_FEED=true
GP_ENABLE_ROLE_PERMISSIONS=true
GP_ENABLE_EXPENSE_INTEGRATION=true
GP_ENABLE_AUTO_CLOSE_POLLS=true

# --- Business Rules & Limits ---
GP_MAX_MEMBERS_PER_GROUP=50
GP_MAX_PLACES_PER_GROUP=1000
GP_MAX_POLLS_PER_GROUP=500
GP_MAX_CHECKLIST_ITEMS_PER_GROUP=200
GP_MAX_PENDING_INVITATIONS=10
GP_INVITATION_EXPIRY_DAYS=7

# --- Real-Time Configuration ---
GP_WEBSOCKET_ENABLED=true
GP_WEBSOCKET_PING_INTERVAL=30
GP_WEBSOCKET_PING_TIMEOUT=5
GP_FALLBACK_POLL_INTERVAL_MS=30000
GP_WEBSOCKET_BROADCAST_TIMEOUT_MS=100

# --- Cache Settings (seconds) ---
GP_CACHE_TTL_GROUPS=300
GP_CACHE_TTL_MEMBERS=600
GP_CACHE_TTL_PLACES=900
GP_CACHE_TTL_POLLS=600
GP_CACHE_TTL_CHECKLIST=300
GP_CACHE_TTL_ACTIVITIES=600
GP_CACHE_TTL_ITINERARY=600
GP_CACHE_TTL_INVITATIONS=300

# --- Performance & Timeouts (seconds) ---
GP_REQUEST_TIMEOUT=30
GP_DB_QUERY_TIMEOUT=10
GP_API_RESPONSE_TIMEOUT=5
GP_EMAIL_TIMEOUT=5.0

# --- Logging & Debugging ---
GP_LOG_LEVEL=INFO
GP_DEBUG_LOGGING=false
GP_ENABLE_PERF_LOGGING=false
GP_LOG_SQL_QUERIES=false

# --- Email Configuration ---
GP_EMAIL_ENABLED=true
GP_EMAIL_RETRY_ATTEMPTS=3
GP_EMAIL_BATCH_SIZE=50

# --- Database Configuration (Travel Data) ---
# SQLite path for destination autocomplete and search
# Travel access uses TRAVEL_DATABASE_PATH above; no separate planner database.
TRAVEL_DATA_CACHE_SIZE_MB=100

# --- Role-Based Access Control ---
# Do not modify these unless you're implementing custom roles
GP_ROLE_CREATOR=creator
GP_ROLE_ADMIN=admin
GP_ROLE_MEMBER=member
GP_ROLE_VIEWER=viewer

# --- Pagination ---
GP_PLACES_PAGE_SIZE=50
GP_ACTIVITIES_PAGE_SIZE=50
GP_MEMBERS_PAGE_SIZE=100

# --- Background Jobs ---
GP_POLL_CLOSE_JOB_INTERVAL=60

# --- Private shared group uploads (API server only) ---
VAULT_STORAGE_BACKEND=database
# Uses the existing DATABASE_URL (Supabase PostgreSQL) by default. No extra key.
# Optional object bucket backend: VAULT_STORAGE_BACKEND=supabase with these settings:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VAULT_BUCKET=tripraft-group-vault
# Create this private bucket in Supabase Storage, maximum 10485760 bytes,
# allowed MIME types application/pdf,image/jpeg,image/png,image/webp.
# Never put the service-role key in frontend/VITE_* settings.
# Explicit offline development only: VAULT_STORAGE_BACKEND=local and UPLOAD_DIR.

# CTO-controlled employee portal only; never copy these settings to engineer servers.
EMPLOYEE_CTO_USER_IDS=
EMPLOYEE_SESSION_VERSION=1
EMAIL_ENABLED=false
# Gmail SMTP uses SMTP_HOST/PORT/USER/PASSWORD and FROM_EMAIL above.
# Worker approval and public HTTPS portal URL live in an external CTO-owned JSON file.
# GitHub remains manual; no GitHub App credentials are needed.
