# Purpose: Documents public API, timeout, branding, support and feature-flag settings; the API base includes /api and OpenFreeMap requires no key.
# Frontend public configuration. Copy to .env.local; never add secrets here.
# Include /api: service paths append /v1/... to this base.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# Group Planner uses OpenFreeMap; no map API key is required.

VITE_APP_NAME=Tripraft
VITE_APP_DESCRIPTION=AI-powered travel planning platform
VITE_APP_TAGLINE=Discover. Plan. Explore.
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
# Optional: a real support inbox displayed on the Contact page.
VITE_SUPPORT_EMAIL=

# Socket.IO uses the origin of VITE_API_BASE_URL with cookie credentials.
# Production example: VITE_API_BASE_URL=https://api.tripraft.com/api
