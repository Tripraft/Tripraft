**/dist
**/__pycache__
**/.pytest_cache
**/.env
**/.env.*
**/*-wal
**/*-shm
data/runtime
data/archive
docs/extra
docs/plans/source-documents
docs/plans/local-archive
services/api/uploads
extra
script
sql_database
wikidata
*.docx
*.pdf
